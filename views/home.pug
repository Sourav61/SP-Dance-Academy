extends base.pug

block scripts
    script(src="../static/script.js")

block style 
    style 
        include ../static/style.css

block content 
    section#introSection 
        p Welcome to SP Dance Academy
        p.small Eat Sleep Dance Repeat
    section#missionSection 
        h2 Our Mission
        div.cards 
            div.card 
                h3 Dance Perfection 
            
                .list-item 
                    img(src="/static/images/dance2.jpeg", alt="Dance Images")
                    | This is the best dance academy of the entire universe

            div.card 
                h3 Dance the way you like 
            
                .list-item 
                    img(src="/static/images/logo.png", alt="Dance Images")
                    | This is the best dance academy of the entire universe

            div.card 
                h3 Expert Teaching 

                .list-item 
                    img(src="/static/images/dance3.png", alt="Dance Images")
                    | This is the best dance academy of the entire universe

    section#sponsorsSection 
        h2 Our Sponsors

        div#sponsors
            img(src="/static/images/logo1-wobg.png", alt="Sponsor-1")
        
            img(src="/static/images/logo2-wobg.png", alt="Sponsor-2")
        
            img(src="/static/images/logo3-wobg.png", alt="Sponsor-3")
        
            img(src="/static/images/logo4-wobg.png", alt="Sponsor-4")
